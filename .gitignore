# deps
node_modules/
dist/
build/

# env / secrets
.env
.env.local
.env.*
.env.*.local
!.env.example
!**/.env.example

# IDE
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# logs
*.log
npm-debug.log*
pnpm-debug.log*

# 本地数据（仅根目录的 data/，避免误伤 apps/web/src/pages/data/）
/data/
/release/
**/outputs/
*.sqlite
*.sqlite-journal
*.zip
*.tar
*.tgz
*.7z

# spec 软链（跨 OS 行为不一致，不入库）
docs/spec

# 配置备份（系统代理/注册表/Mielink 等，不进 git）
backups/

# 本次产生的临时调试文件
tmp_test_parse.mjs

# 本地验收截图和真实数据验证输出（旧提交仍保留历史文件；当前及新输出一律不入库）
/outputs/
/artifacts/
/apps/api/artifacts/
/apps/api/apps/
/docs/HANDOFF-*.md

# 真实业务样本、脱敏副本和隔离验收导出不得进入 git
/real-samples/
/sample-acceptance/
/front-profit-real-samples/
/front-profit-acceptance/
/front-profit-production-release/
/docs/front-profit-acceptance-manifest*.json
/docs/front-profit-acceptance-result*.json
/docs/front-profit-production-release*.json
**/*real-sample*
**/*real_sample*
**/*真实样本*
**/*脱敏样本*
!docs/front-profit-real-sample-acceptance-template.md
!docs/front-profit-acceptance-manifest.example.json
!docs/front-profit-acceptance-result.example.json
!docs/front-profit-production-release.example.json


# 项目级权限配置（每人不同，不入 git）
.claude/
.codegraph/
.worktrees/

*.tsbuildinfo

# Python runtime caches are generated by cloud-kit validation and never belong in a release.
__pycache__/
*.py[cod]
