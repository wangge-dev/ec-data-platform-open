# Local development environment. Copy to `.env` and replace all change_me values.
POSTGRES_PASSWORD=change_me_to_strong_password
APP_DB_PASSWORD=change_me_app_db_password
ADMIN_PASSWORD=change_me_admin_password
JWT_SECRET=change_me_to_a_long_random_string_at_least_32_chars
DEEPSEEK_API_KEY=
CORS_ORIGIN=http://localhost:5173

DATABASE_URL=postgres://ec_app:change_me_app_db_password@127.0.0.1:5432/ec_data
MIGRATION_DATABASE_URL=postgres://ec:change_me_to_strong_password@127.0.0.1:5432/ec_data
REDIS_URL=redis://127.0.0.1:6379
PORT=4000
