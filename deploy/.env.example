# ============================================================
# ec-data-platform 部署环境变量模板
# 复制为 .env 后填入真实值（注意 .env 已加入 .gitignore，不会提交）
# 四个必填密钥只使用不带引号的 ASCII 单行值；不要使用空白、行尾注释、$ 插值、引号或反斜杠。
# 两个数据库密码会进入 PostgreSQL URI，只使用字母、数字、点、下划线、波浪号和连字符。
# ============================================================

# Stable operator-facing identity used by backup/restore safety checks.
# Use a unique 3-63 character lowercase value per deployed instance.
INSTANCE_ID=change_me_instance_id

# Postgres 超级用户密码（生产请改强密码）——仅用于建库/建角色/迁移
POSTGRES_PASSWORD=change_me_to_strong_password

# 应用运行时 DB 密码（最小权限角色 ec_app，非 superuser）
# 首次部署需先建角色（见下方"安全建议"），此处填该角色密码
APP_DB_PASSWORD=change_me_app_db_password

# Initial admin password used when the seed creates the admin account.
# Existing installations keep their current admin password.
ADMIN_PASSWORD=change_me_admin_password

# DeepSeek API Key（可选，去 https://platform.deepseek.com 申请）
# 留空时上传、ETL、模块和普通看板仍可用，AI 出图与智能体不可用
DEEPSEEK_API_KEY=

# JWT 签名密钥（生产必改！至少 32 字符随机串）
# 生成方式：openssl rand -hex 32
JWT_SECRET=change_me_to_a_long_random_string_at_least_32_chars

# CORS 来源（前端访问地址，多个用逗号分隔）
# 本机部署默认 http://localhost:3997；同事/服务器部署改为对应域名/IP
CORS_ORIGIN=http://localhost:3997

# Optional overrides for a parallel deployment. Leave this block commented for
# the existing single-project behavior. A parallel deployment must use a unique
# project name, host ports, and container names before running compose up/down.
# COMPOSE_PROJECT_NAME=ec-data-platform-parallel
# Host ports default to loopback-only bindings. Include an explicit host IP
# when overriding them; do not use a bare port unless all-interface exposure
# is intentional and protected by a firewall/reverse proxy.
# POSTGRES_HOST_PORT=127.0.0.1:5432
# REDIS_HOST_PORT=127.0.0.1:6379
# API_HOST_PORT=127.0.0.1:4000
# WEB_HOST_PORT=127.0.0.1:3997
# POSTGRES_CONTAINER_NAME=ec-data-postgres
# REDIS_CONTAINER_NAME=ec-data-redis
# MIGRATE_CONTAINER_NAME=ec-data-migrate
# API_CONTAINER_NAME=ec-data-api
# WEB_CONTAINER_NAME=ec-data-web

# 外部 SQL 数据源加密密钥（不填则从 JWT_SECRET 派生）
# ENCRYPTION_KEY=another_long_random_string

# 外部 SQL SSRF 防护：默认拒绝连接内网/保留/元数据地址（169.254.169.254 等）。
# 外部 SQL 仍必须使用目标库的最小权限只读账号；TLS 连接必须使用证书匹配的 DNS 域名。
# 若外部 DB 恰在内网、纯内网自部署确需放开，设为 1（有内网探测风险，谨慎）。
# ALLOW_PRIVATE_SQL_HOST=0

# Security lifecycle: application traffic uses the non-superuser ec_app role.
# `docker compose up -d` runs the one-shot `migrate` service as the database
# owner before API startup. The migrator owns fixed public tables and grants
# ec_app DML access. Its search_path is public,user_data so unqualified fixed
# reads cannot be shadowed; runtime DDL remains explicitly scoped to user_data.
