{
  "schemaVersion": "vertical-solution/v1",
  "id": "ecommerce.starter",
  "version": 1,
  "label": "电商经营分析起步方案",
  "description": "演示如何把销售与库存两个纯配置模块及连接器要求作为一个无数据、无密钥的可移植方案交付。",
  "dataPolicy": {
    "containsBusinessData": false,
    "containsSecrets": false
  },
  "modules": [
    {
      "schemaVersion": "module-manifest/v1",
      "module": {
        "code": "example_sales",
        "name": "示例销售",
        "category": "diy",
        "categoryLabel": "DIY 模块",
        "description": "纯配置普通销售模块示例，不包含可执行 transform。",
        "columns": [
          {
            "name": "occurred_on",
            "source": ["日期", "occurred_on"],
            "type": "date",
            "required": true,
            "label": "日期",
            "semanticRole": "time"
          },
          {
            "name": "channel",
            "source": ["渠道", "channel"],
            "type": "text",
            "label": "渠道",
            "semanticRole": "dimension"
          },
          {
            "name": "sales_amount",
            "source": ["销售额", "sales_amount"],
            "type": "numeric",
            "required": true,
            "label": "销售额",
            "semanticRole": "amount"
          }
        ],
        "platforms": [
          {
            "code": "generic",
            "name": "通用导出",
            "filePattern": "销售|sales",
            "patternFlags": "i",
            "enabled": true
          }
        ],
        "timeKey": "occurred_on",
        "usages": ["summary", "ai_chart", "ai_analysis"],
        "enabled": true,
        "hasTransform": false,
        "semanticModel": {
          "schemaVersion": "semantic-manifest/v1",
          "id": "example_sales.analysis",
          "version": 1,
          "dimensions": [
            {
              "id": "example_sales.date",
              "label": "日期",
              "field": "occurred_on",
              "kind": "time"
            },
            {
              "id": "example_sales.channel",
              "label": "渠道",
              "field": "channel",
              "kind": "categorical"
            }
          ],
          "metrics": [
            {
              "id": "example_sales.sales_amount",
              "label": "销售额",
              "aggregation": "sum",
              "field": "sales_amount",
              "unit": "currency",
              "additiveAcrossTime": true
            }
          ]
        }
      }
    },
    {
      "schemaVersion": "module-manifest/v1",
      "module": {
        "code": "example_inventory",
        "name": "示例库存",
        "category": "diy",
        "categoryLabel": "DIY 模块",
        "description": "库存快照模块示例，库存量不允许脱离快照日期跨时间直接相加。",
        "columns": [
          {
            "name": "snapshot_on",
            "source": ["快照日期", "snapshot_on"],
            "type": "date",
            "required": true,
            "label": "快照日期",
            "semanticRole": "time"
          },
          {
            "name": "sku",
            "source": ["SKU", "sku"],
            "type": "text",
            "required": true,
            "label": "SKU",
            "semanticRole": "sku"
          },
          {
            "name": "warehouse",
            "source": ["仓库", "warehouse"],
            "type": "text",
            "label": "仓库",
            "semanticRole": "dimension"
          },
          {
            "name": "stock_qty",
            "source": ["库存量", "stock_qty"],
            "type": "numeric",
            "required": true,
            "label": "库存量",
            "semanticRole": "quantity"
          }
        ],
        "platforms": [
          {
            "code": "generic",
            "name": "通用导出",
            "filePattern": "库存|inventory",
            "patternFlags": "i",
            "enabled": true
          }
        ],
        "timeKey": "snapshot_on",
        "usages": ["summary", "ai_chart", "ai_analysis"],
        "enabled": true,
        "hasTransform": false,
        "semanticModel": {
          "schemaVersion": "semantic-manifest/v1",
          "id": "example_inventory.analysis",
          "version": 1,
          "dimensions": [
            {
              "id": "example_inventory.snapshot_date",
              "label": "快照日期",
              "field": "snapshot_on",
              "kind": "time"
            },
            {
              "id": "example_inventory.sku",
              "label": "SKU",
              "field": "sku",
              "kind": "categorical"
            },
            {
              "id": "example_inventory.warehouse",
              "label": "仓库",
              "field": "warehouse",
              "kind": "categorical"
            }
          ],
          "metrics": [
            {
              "id": "example_inventory.stock_qty",
              "label": "库存量",
              "aggregation": "sum",
              "field": "stock_qty",
              "unit": "quantity",
              "additiveAcrossTime": false
            }
          ]
        }
      }
    }
  ],
  "requiredConnectors": [
    {
      "id": "warehouse.postgres",
      "version": 1
    }
  ]
}
